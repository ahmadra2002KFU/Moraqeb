# ============================================
# Moraqeb (مراقب) Intelligence Engine — Configuration
# ============================================
# Copy this file to .env and fill in your keys.
# Keys are optional — sources without keys degrade gracefully.
#
# IMPORTANT: Do NOT put comments on the same line as values.
# Docker env_file treats inline comments as part of the value.

# === OSINT Source API Keys ===

# Federal Reserve Economic Data (free: fred.stlouisfed.org/docs/api)
FRED_API_KEY=
# NASA FIRMS fire data (free: firms.modaps.eosdis.nasa.gov/api)
FIRMS_MAP_KEY=
# Energy Information Administration (free: api.eia.gov/register)
EIA_API_KEY=
# Maritime AIS data (aisstream.io)
AISSTREAM_API_KEY=
# Armed Conflict Location & Event Data (acleddata.com/user/register)
ACLED_EMAIL=
# OAuth2 password grant (API keys deprecated Sept 2025)
ACLED_PASSWORD=
# Cloudflare Radar internet outages & traffic anomalies (free: dash.cloudflare.com/profile/api-tokens, Account Analytics Read)
CLOUDFLARE_API_TOKEN=

# === Server Configuration ===

# Dashboard server port
PORT=3117
# Auto-refresh interval (minutes)
REFRESH_INTERVAL_MINUTES=15
# Blog generation interval (minutes) — decoupled from sweep, defaults to 60
BLOG_INTERVAL_MINUTES=60

# === LLM Layer ===
# OmniRoute GPT-5.6 Luna with low reasoning is the default. Set LLM_PROVIDER=disabled to opt out.
# Provider options: omniroute | anthropic | openai | gemini | codex | openrouter | minimax | mistral | ollama | disabled
LLM_PROVIDER=omniroute
# Not needed for codex (uses ~/.codex/auth.json) or ollama (local).
# Generic key for providers without a dedicated key variable.
LLM_API_KEY=
# A local OmniRoute instance may accept a non-secret client label when key enforcement is disabled.
OMNIROUTE_API_KEY=local-moraqeb
# Optional generic overrides for non-OmniRoute providers. Leave blank when switching
# providers unless that provider needs a custom model/base URL.
LLM_MODEL=
LLM_BASE_URL=
# OmniRoute-specific defaults do not leak into other provider selections.
OMNIROUTE_MODEL=cx/gpt-5.6-luna
OMNIROUTE_BASE_URL=http://host.docker.internal:20128/v1
OMNIROUTE_REASONING_EFFORT=low
# Generic provider reasoning mode when supported: none | low | medium | high
LLM_REASONING_EFFORT=
# Ollama base URL (only needed if not using default http://localhost:11434)
OLLAMA_BASE_URL=

# === MiniMax API Key (legacy fallback when LLM_PROVIDER=minimax) ===
# Subscribe at https://platform.minimax.io/subscribe/token-plan
# Get your Token Plan key at https://platform.minimax.io/user-center/payment/token-plan
MINIMAX_API_KEY=
# Optional model override (default: MiniMax-M2.7)
MINIMAX_MODEL=

# === Gemini API Key (Voice only) ===
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# === Telegram Alerts (optional, requires LLM) ===
# Create a bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
